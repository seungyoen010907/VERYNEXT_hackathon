# 이 파일을 .env.local 로 복사해 값을 채운다. .env.local 은 Git에 올리지 않는다.

# Supabase (STEP 4부터 사용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 브라우저 코드에서 절대 사용하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (STEP 12부터 사용, 서버 전용)
OPENAI_API_KEY=

# 팀원 AI 문서 분석 모듈 (선택). 설정하면 업로드 시 이 주소로 파일을 보내 분석한다.
DOCUMENT_ANALYSIS_API_URL=
DOCUMENT_ANALYSIS_API_KEY=
